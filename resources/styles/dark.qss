/* xsync Dark Theme - Crisp, low-overhead Fusion styling */
QMainWindow, QDialog {
    background-color: #161922;
    color: #e2e8f0;
}
QWidget {
    color: #e2e8f0;
    font-family: "Segoe UI", "Microsoft YaHei UI", "Inter", "Noto Sans CJK SC", sans-serif;
    font-size: 9.5pt;
}
QMenuBar {
    background-color: #1c202b;
    border-bottom: 1px solid #2b3142;
    padding: 2px 4px;
}
QMenuBar::item:selected {
    background-color: #2c3448;
    border-radius: 4px;
}
QMenu {
    background-color: #1f2431;
    border: 1px solid #323a4f;
    padding: 4px;
}
QMenu::item {
    padding: 5px 22px 5px 12px;
    border-radius: 4px;
}
QMenu::item:selected {
    background-color: #2563eb;
    color: #ffffff;
}
QToolBar {
    background-color: #1c202b;
    border-bottom: 1px solid #2b3142;
    spacing: 6px;
    padding: 4px 8px;
}
QPushButton, QToolButton {
    background-color: #262c3b;
    border: 1px solid #363f54;
    border-radius: 5px;
    padding: 4px 10px;
    color: #e2e8f0;
}
QPushButton:hover, QToolButton:hover {
    background-color: #323a4f;
    border-color: #4b5775;
}
QPushButton:pressed, QToolButton:pressed {
    background-color: #1e2433;
}
QPushButton#primaryBtn {
    background-color: #2563eb;
    border-color: #3b82f6;
    color: #ffffff;
    font-weight: 600;
}
QPushButton#primaryBtn:hover {
    background-color: #1d4ed8;
}
QLineEdit, QComboBox, QSpinBox {
    background-color: #11141c;
    border: 1px solid #31394d;
    border-radius: 5px;
    padding: 4px 8px;
    color: #f1f5f9;
    selection-background-color: #2563eb;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus {
    border-color: #3b82f6;
}
QTabWidget::pane {
    border: 1px solid #2b3142;
    background-color: #191d27;
    border-radius: 4px;
}
QTabBar::tab {
    background-color: #1e2330;
    border: 1px solid #2b3142;
    border-bottom: none;
    padding: 5px 12px;
    margin-right: 2px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    color: #94a3b8;
}
QTabBar::tab:selected {
    background-color: #252c3d;
    color: #ffffff;
    font-weight: 600;
    border-top: 2px solid #3b82f6;
}
QTabBar::tab:hover:!selected {
    background-color: #232938;
    color: #cbd5e1;
}
QTableView, QTreeView, QTreeWidget {
    background-color: #141821;
    alternate-background-color: #181d28;
    border: 1px solid #2a3040;
    gridline-color: #222836;
    selection-background-color: #2563eb;
    selection-color: #ffffff;
    outline: 0;
}
QTableView::item, QTreeView::item {
    padding: 3px 6px;
}
QHeaderView::section {
    background-color: #1d2230;
    color: #94a3b8;
    border: none;
    border-right: 1px solid #2b3142;
    border-bottom: 1px solid #2b3142;
    padding: 5px 8px;
    font-weight: 600;
}
QPlainTextEdit {
    background-color: #10131a;
    color: #cbd5e1;
    border: 1px solid #2a3040;
    font-family: "Cascadia Code", "Consolas", "JetBrains Mono", monospace;
    font-size: 8.8pt;
}
QSplitter::handle {
    background-color: #262c3b;
}
QSplitter::handle:hover {
    background-color: #3b82f6;
}
QStatusBar {
    background-color: #1c202b;
    border-top: 1px solid #2b3142;
    color: #94a3b8;
}
QLabel#capBadge {
    background-color: #1e293b;
    border: 1px solid #334155;
    border-radius: 4px;
    padding: 2px 7px;
    color: #38bdf8;
    font-weight: 600;
    font-size: 8.5pt;
}
QLabel#ramBadge {
    background-color: #172554;
    border: 1px solid #1e40af;
    border-radius: 4px;
    padding: 1px 7px;
    color: #93c5fd;
    font-weight: 600;
    font-size: 8.5pt;
}
QFrame#paneHeader {
    background-color: #1d2230;
    border-bottom: 1px solid #2b3142;
}
QScrollBar:vertical {
    background: #141821;
    width: 10px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #334155;
    min-height: 24px;
    border-radius: 5px;
    margin: 2px;
}
QScrollBar::handle:vertical:hover {
    background: #475569;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
    height: 0;
}
QScrollBar:horizontal {
    background: #141821;
    height: 10px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: #334155;
    min-width: 24px;
    border-radius: 5px;
    margin: 2px;
}
QScrollBar::handle:horizontal:hover {
    background: #475569;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
    width: 0;
}
QComboBox QAbstractItemView {
    background-color: #1c212e;
    border: 1px solid #334155;
    selection-background-color: #2563eb;
    selection-color: #ffffff;
}

