/* xsync Light Theme — Unified Fusion QSS (1:1 structural parity with dark.qss) */

/* ---- Base Windows & Typography ---- */
QMainWindow, QDialog {
    background-color: #f4f6fa;
    color: #0f172a;
}
QWidget {
    color: #0f172a;
    font-family: "Segoe UI", "Microsoft YaHei UI", "Inter", "Noto Sans CJK SC", sans-serif;
    font-size: 9.5pt;
}
QLabel:disabled {
    color: #94a3b8;
}

/* ---- Menu Bar & Menus ---- */
QMenuBar {
    background-color: #ffffff;
    border-bottom: 1px solid #e2e8f0;
    padding: 2px 4px;
    spacing: 2px;
}
QMenuBar::item {
    padding: 4px 8px;
    border-radius: 4px;
    background-color: transparent;
    color: #0f172a;
}
QMenuBar::item:selected {
    background-color: #e2e8f0;
    color: #0f172a;
}
QMenuBar::item:pressed {
    background-color: #2563eb;
    color: #ffffff;
}
QMenu {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    padding: 4px;
    color: #0f172a;
}
QMenu::item {
    padding: 5px 24px 5px 22px;
    border-radius: 4px;
    min-height: 20px;
    background-color: transparent;
    color: #0f172a;
}
QMenu::item:selected {
    background-color: #2563eb;
    color: #ffffff;
}
QMenu::item:disabled {
    color: #94a3b8;
    background-color: transparent;
}
QMenu::separator {
    height: 1px;
    background-color: #e2e8f0;
    margin: 4px 8px;
}
QMenu::icon {
    padding-left: 6px;
}
QMenu::indicator {
    width: 14px;
    height: 14px;
    margin-left: 6px;
}
QMenu::indicator:non-exclusive:unchecked {
    border: 1px solid #94a3b8;
    border-radius: 3px;
    background-color: #ffffff;
}
QMenu::indicator:non-exclusive:unchecked:selected {
    border-color: #bfdbfe;
}
QMenu::indicator:non-exclusive:checked {
    border: 1px solid #2563eb;
    border-radius: 3px;
    background-color: #2563eb;
    image: url(:/icons/ui/check_white.svg);
}
QMenu::right-arrow {
    image: url(:/icons/ui/chevron_right_light.svg);
    width: 10px;
    height: 10px;
    right: 8px;
}
QMenu::right-arrow:selected {
    image: url(:/icons/ui/chevron_right_white.svg);
}

/* ---- Toolbars ---- */
QToolBar {
    background-color: #ffffff;
    border: none;
    border-bottom: 1px solid #e2e8f0;
    spacing: 2px;
    padding: 4px 5px;
}
QToolBar::separator {
    background-color: #e2e8f0;
    width: 1px;
    margin: 4px 1px;
}
QFrame#toolbarDivider {
    background-color: #e2e8f0;
    border: none;
}
QLabel#toolbarTitle {
    color: #0f172a;
    font-weight: 600;
    padding: 0px 4px 0px 2px;
}
QLabel#toolbarLabel {
    color: #475569;
    padding: 0px 1px 0px 2px;
    font-size: 8.8pt;
}

/* ---- Buttons (T3 Standard 28px Outer Height by Default) ---- */
QPushButton, QToolButton {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 5px;
    padding: 0px 10px;
    min-height: 26px;
    max-height: 26px;
    color: #1e293b;
    outline: 0;
}
QPushButton:hover, QToolButton:hover {
    background-color: #f1f5f9;
    border-color: #94a3b8;
    color: #0f172a;
}
QPushButton:focus, QToolButton:focus {
    border-color: #2563eb;
}
QPushButton:pressed, QToolButton:pressed,
QPushButton:checked, QToolButton:checked,
QToolButton:open {
    background-color: #e2e8f0;
    border-color: #94a3b8;
}
QPushButton:disabled, QToolButton:disabled {
    background-color: #f8fafc;
    border-color: #e2e8f0;
    color: #94a3b8;
}

/* Subtle / Ghost variant (Main Toolbar & Nav Bar buttons) */
QToolBar QToolButton,
QToolButton[variant="subtle"],
QPushButton[variant="subtle"] {
    background-color: transparent;
    border: 1px solid transparent;
    color: #334155;
}
QToolBar QToolButton {
    padding: 0px 2px;
    font-size: 9pt;
}
QToolBar QToolButton:hover,
QToolButton[variant="subtle"]:hover,
QPushButton[variant="subtle"]:hover {
    background-color: #e2e8f0;
    border-color: #cbd5e1;
    color: #0f172a;
}
QToolBar QToolButton:pressed,
QToolBar QToolButton:open,
QToolButton[variant="subtle"]:pressed,
QToolButton[variant="subtle"]:open,
QPushButton[variant="subtle"]:pressed {
    background-color: #cbd5e1;
    border-color: #94a3b8;
    color: #0f172a;
}
QToolBar QToolButton:disabled,
QToolButton[variant="subtle"]:disabled,
QPushButton[variant="subtle"]:disabled {
    background-color: transparent;
    border-color: transparent;
    color: #94a3b8;
}

/* Danger variant */
QPushButton[variant="danger"] {
    background-color: #fef2f2;
    border-color: #fecaca;
    color: #b91c1c;
}
QPushButton[variant="danger"]:hover {
    background-color: #dc2626;
    border-color: #b91c1c;
    color: #ffffff;
}
QPushButton[variant="danger"]:pressed {
    background-color: #b91c1c;
    border-color: #991b1b;
    color: #ffffff;
}
QPushButton[variant="danger"]:disabled {
    background-color: #f8fafc;
    border-color: #e2e8f0;
    color: #94a3b8;
}

/* Primary CTA variant (explicit #primaryBtn:disabled overrides ID specificity) */
QPushButton#primaryBtn,
QPushButton[variant="primary"] {
    background-color: #2563eb;
    border-color: #1d4ed8;
    color: #ffffff;
    font-weight: 600;
}
QPushButton#primaryBtn:hover,
QPushButton[variant="primary"]:hover {
    background-color: #1d4ed8;
    border-color: #1e40af;
    color: #ffffff;
}
QPushButton#primaryBtn:pressed,
QPushButton[variant="primary"]:pressed {
    background-color: #1e3a8a;
    border-color: #1e3a8a;
    color: #ffffff;
}
QPushButton#primaryBtn:disabled,
QPushButton[variant="primary"]:disabled {
    background-color: #e2e8f0;
    border-color: #cbd5e1;
    color: #94a3b8;
}

/* Active accent toggle (bookmarked star, globally paused queue button) */
QToolButton#starBtnActive,
QToolButton[active="true"],
QPushButton[active="true"] {
    background-color: #fef3c7;
    border-color: #f59e0b;
    color: #b45309;
}
QToolButton#starBtnActive:hover,
QToolButton[active="true"]:hover,
QPushButton[active="true"]:hover {
    background-color: #fde68a;
    border-color: #d97706;
    color: #92400e;
}
QToolButton#starBtnActive:disabled,
QToolButton[active="true"]:disabled,
QPushButton[active="true"]:disabled {
    background-color: #f8fafc;
    border-color: #e2e8f0;
    color: #94a3b8;
}

/* Button Size Tiers: T1 Icon (28x28), T1b IconDropdown (40x28), T2 Compact (24px), T4 Dialog (30px) */
QToolButton[btnSize="icon"],
QPushButton[btnSize="icon"] {
    min-width: 26px;
    max-width: 26px;
    min-height: 26px;
    max-height: 26px;
    padding: 0px;
    border-radius: 5px;
}
QToolButton[btnSize="iconDropdown"] {
    min-width: 20px;
    max-width: 20px;
    min-height: 26px;
    max-height: 26px;
    padding: 0px 14px 0px 4px;
    border-radius: 5px;
}
QToolButton[btnSize="compact"],
QPushButton[btnSize="compact"] {
    min-height: 22px;
    max-height: 22px;
    padding: 0px 8px;
    border-radius: 4px;
    font-size: 8.5pt;
}
QToolButton[btnSize="compact"][hasMenu="true"] {
    padding: 0px 20px 0px 8px;
}
QDialogButtonBox {
    dialogbuttonbox-buttons-have-icons: 0;
}
QDialogButtonBox QPushButton,
QMessageBox QPushButton,
QPushButton[btnSize="dialog"] {
    min-height: 28px;
    max-height: 28px;
    min-width: 56px;
    padding: 0px 13px;
    border-radius: 6px;
}
QMessageBox QLabel {
    background-color: transparent;
}

/* QToolButton dropdown chevron matching QComboBox::down-arrow */
QToolButton::menu-indicator {
    image: url(:/icons/ui/chevron_down_light.svg);
    subcontrol-origin: border;
    subcontrol-position: center right;
    right: 5px;
    width: 10px;
    height: 10px;
}
QToolButton::menu-indicator:disabled {
    image: url(:/icons/ui/chevron_down_disabled_light.svg);
}
QToolButton::menu-button {
    border: none;
    border-left: 1px solid #cbd5e1;
    width: 16px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
}
QToolButton::menu-arrow {
    image: url(:/icons/ui/chevron_down_light.svg);
    width: 10px;
    height: 10px;
}

/* ---- QLineEdit (T3 28px Outer Height) ---- */
QLineEdit {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 5px;
    padding: 0px 8px;
    min-height: 26px;
    max-height: 26px;
    color: #0f172a;
    selection-background-color: #2563eb;
    selection-color: #ffffff;
}
QLineEdit:hover {
    border-color: #94a3b8;
}
QLineEdit:focus {
    border-color: #2563eb;
}
QLineEdit:disabled {
    background-color: #f1f5f9;
    border-color: #e2e8f0;
    color: #94a3b8;
}

/* ---- QComboBox (Fusion SH_ComboBox_Popup=0 + SVG chevron + editable inner-edit reset) ---- */
QComboBox {
    combobox-popup: 0;
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 5px;
    padding: 0px 6px 0px 8px;
    min-height: 26px;
    max-height: 26px;
    color: #0f172a;
    selection-background-color: #2563eb;
    selection-color: #ffffff;
}
QComboBox:hover {
    border-color: #94a3b8;
}
QComboBox:focus, QComboBox:on {
    border-color: #2563eb;
}
QComboBox:disabled {
    background-color: #f1f5f9;
    border-color: #e2e8f0;
    color: #94a3b8;
}
QComboBox:editable {
    background-color: #ffffff;
}
QComboBox:editable:disabled {
    background-color: #f1f5f9;
}
QComboBox QLineEdit,
QComboBox QLineEdit:hover,
QComboBox QLineEdit:focus,
QComboBox QLineEdit:disabled {
    background-color: transparent;
    border: none;
    border-radius: 0px;
    padding: 0px;
    margin: 0px;
    min-height: 0px;
    max-height: 4096px;
}
QComboBox::drop-down {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 20px;
    margin: 1px 1px 1px 0px;
    border: none;
    border-left: 1px solid #e2e8f0;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    background-color: transparent;
}
QComboBox::drop-down:hover {
    background-color: #f1f5f9;
}
QComboBox::drop-down:on {
    background-color: #e2e8f0;
}
QComboBox::drop-down:disabled {
    background-color: transparent;
    border-left-color: #e2e8f0;
}
QComboBox::down-arrow {
    image: url(:/icons/ui/chevron_down_light.svg);
    width: 12px;
    height: 12px;
}
QComboBox::down-arrow:on {
    image: url(:/icons/ui/chevron_up_light.svg);
}
QComboBox::down-arrow:disabled {
    image: url(:/icons/ui/chevron_down_disabled_light.svg);
}

/* ComboBox Popup List (opaque single border — zero black corners/shadow artifacts) */
QFrame#comboPopupContainer {
    background-color: #ffffff;
    border: none;
}
QComboBox QAbstractItemView,
QListView#comboPopupView {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    padding: 4px;
    color: #0f172a;
    selection-background-color: #2563eb;
    selection-color: #ffffff;
    outline: 0;
}
QComboBox QAbstractItemView::item,
QListView#comboPopupView::item {
    min-height: 24px;
    padding: 3px 8px;
    border-radius: 4px;
    color: #0f172a;
}
QComboBox QAbstractItemView::item:hover,
QListView#comboPopupView::item:hover {
    background-color: #eff6ff;
    color: #0f172a;
}
QComboBox QAbstractItemView::item:selected,
QListView#comboPopupView::item:selected {
    background-color: #2563eb;
    color: #ffffff;
}

/* ---- QSpinBox / QDoubleSpinBox (T3 28px Outer Height + 13px Stacked SVG Steppers) ---- */
QSpinBox, QDoubleSpinBox {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 5px;
    padding: 0px 4px 0px 8px;
    min-height: 26px;
    max-height: 26px;
    color: #0f172a;
    selection-background-color: #2563eb;
    selection-color: #ffffff;
}
QSpinBox:hover, QDoubleSpinBox:hover {
    border-color: #94a3b8;
}
QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #2563eb;
}
QSpinBox:disabled, QDoubleSpinBox:disabled {
    background-color: #f1f5f9;
    border-color: #e2e8f0;
    color: #94a3b8;
}
QSpinBox QLineEdit,
QSpinBox QLineEdit:hover,
QSpinBox QLineEdit:focus,
QSpinBox QLineEdit:disabled,
QDoubleSpinBox QLineEdit,
QDoubleSpinBox QLineEdit:hover,
QDoubleSpinBox QLineEdit:focus,
QDoubleSpinBox QLineEdit:disabled {
    background-color: transparent;
    border: none;
    border-radius: 0px;
    padding: 0px;
    margin: 0px;
    min-height: 0px;
    max-height: 4096px;
}
QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 19px;
    height: 12px;
    margin: 1px 1px 0px 0px;
    border: none;
    border-left: 1px solid #e2e8f0;
    border-bottom: 1px solid #e2e8f0;
    border-top-right-radius: 4px;
    background-color: #f8fafc;
}
QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 19px;
    height: 13px;
    margin: 0px 1px 1px 0px;
    border: none;
    border-left: 1px solid #e2e8f0;
    border-bottom-right-radius: 4px;
    background-color: #f8fafc;
}
QSpinBox::up-button:hover, QSpinBox::down-button:hover,
QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #e2e8f0;
}
QSpinBox::up-button:pressed, QSpinBox::down-button:pressed,
QDoubleSpinBox::up-button:pressed, QDoubleSpinBox::down-button:pressed {
    background-color: #cbd5e1;
}
QSpinBox::up-button:disabled, QSpinBox::down-button:disabled,
QDoubleSpinBox::up-button:disabled, QDoubleSpinBox::down-button:disabled {
    background-color: #f1f5f9;
    border-color: #e2e8f0;
}
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url(:/icons/ui/chevron_up_light.svg);
    width: 9px;
    height: 9px;
}
QSpinBox::up-arrow:disabled, QSpinBox::up-arrow:off,
QDoubleSpinBox::up-arrow:disabled, QDoubleSpinBox::up-arrow:off {
    image: url(:/icons/ui/chevron_up_disabled_light.svg);
}
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url(:/icons/ui/chevron_down_light.svg);
    width: 9px;
    height: 9px;
}
QSpinBox::down-arrow:disabled, QSpinBox::down-arrow:off,
QDoubleSpinBox::down-arrow:disabled, QDoubleSpinBox::down-arrow:off {
    image: url(:/icons/ui/chevron_down_disabled_light.svg);
}

/* ---- QCheckBox & QRadioButton ---- */
QCheckBox, QRadioButton {
    spacing: 8px;
    color: #0f172a;
}
QCheckBox:disabled, QRadioButton:disabled {
    color: #94a3b8;
}
QCheckBox::indicator {
    width: 15px;
    height: 15px;
    border: 1px solid #94a3b8;
    border-radius: 4px;
    background-color: #ffffff;
}
QCheckBox::indicator:hover {
    border-color: #2563eb;
}
QCheckBox::indicator:checked {
    background-color: #2563eb;
    border-color: #2563eb;
    image: url(:/icons/ui/check_white.svg);
}
QCheckBox::indicator:checked:hover {
    background-color: #1d4ed8;
    border-color: #1d4ed8;
}
QCheckBox::indicator:disabled {
    background-color: #f1f5f9;
    border-color: #cbd5e1;
}
QCheckBox::indicator:checked:disabled {
    background-color: #e2e8f0;
    border-color: #cbd5e1;
    image: url(:/icons/ui/check_disabled_light.svg);
}
QRadioButton::indicator {
    width: 15px;
    height: 15px;
    border: 1px solid #94a3b8;
    border-radius: 8px;
    background-color: #ffffff;
}
QRadioButton::indicator:hover {
    border-color: #2563eb;
}
QRadioButton::indicator:checked {
    border: 4px solid #2563eb;
    background-color: #ffffff;
}
QRadioButton::indicator:disabled {
    background-color: #f1f5f9;
    border-color: #cbd5e1;
}

/* ---- Tabs ---- */
QTabWidget::pane {
    border: 1px solid #cbd5e1;
    background-color: #ffffff;
    border-radius: 4px;
}
QTabBar::tab {
    background-color: #e9eef5;
    border: 1px solid #cbd5e1;
    border-bottom: none;
    min-height: 26px;
    padding: 0px 10px;
    margin-right: 2px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    color: #475569;
    outline: 0;
}
QTabBar::tab:selected {
    background-color: #ffffff;
    color: #0f172a;
    font-weight: 600;
    border-top: 2px solid #2563eb;
}
QTabBar::tab:hover:!selected {
    background-color: #f1f5f9;
    color: #1e293b;
}
QTabBar::close-button {
    image: url(:/icons/ui/close_light.svg);
    subcontrol-position: right;
    border-radius: 3px;
    padding: 2px;
}
QTabBar::close-button:hover {
    image: url(:/icons/ui/close_light_hover.svg);
    background-color: #e2e8f0;
}
QTabBar::close-button:pressed {
    background-color: #cbd5e1;
}
QTabBar QToolButton {
    background-color: #f1f5f9;
    border: 1px solid #cbd5e1;
    border-radius: 3px;
    min-height: 0px;
    max-height: 4096px;
    padding: 0px;
}
QTabBar QToolButton:hover {
    background-color: #e2e8f0;
}

/* ---- Tables, Trees & Headers ---- */
QTableView, QTreeView, QTreeWidget {
    background-color: #ffffff;
    alternate-background-color: #f8fafc;
    border: 1px solid #dbe2ea;
    gridline-color: #eef2f6;
    selection-background-color: #2563eb;
    selection-color: #ffffff;
    outline: 0;
}
QTableView::item, QTreeView::item {
    padding: 2px 1px;
}
QTreeView::item {
    min-height: 24px;
}
QTableView::item:hover, QTreeView::item:hover {
    background-color: #f1f5f9;
}
QTableView::item:selected:active, QTreeView::item:selected:active {
    background-color: #2563eb;
    color: #ffffff;
}
QTableView::item:selected:!active, QTreeView::item:selected:!active {
    background-color: #dbeafe;
    color: #1e293b;
}
QTreeView::branch {
    background-color: transparent;
}
QTreeView::branch:hover {
    background-color: #f1f5f9;
}
QTreeView::branch:selected:active {
    background-color: #2563eb;
}
QTreeView::branch:selected:!active {
    background-color: #dbeafe;
}
QTreeView::branch:has-children:!has-siblings:closed,
QTreeView::branch:closed:has-children:has-siblings {
    image: url(:/icons/ui/chevron_right_light.svg);
}
QTreeView::branch:open:has-children:!has-siblings,
QTreeView::branch:open:has-children:has-siblings {
    image: url(:/icons/ui/chevron_down_light.svg);
}
QTreeView::branch:has-children:!has-siblings:closed:selected:active,
QTreeView::branch:closed:has-children:has-siblings:selected:active {
    image: url(:/icons/ui/chevron_right_white.svg);
}
QTreeView::branch:open:has-children:!has-siblings:selected:active,
QTreeView::branch:open:has-children:has-siblings:selected:active {
    image: url(:/icons/ui/chevron_down_white.svg);
}

QHeaderView {
    background-color: #f1f5f9;
    border: none;
}
QHeaderView::section {
    background-color: #f1f5f9;
    color: #475569;
    border: none;
    border-right: 1px solid #e2e8f0;
    border-bottom: 1px solid #cbd5e1;
    height: 28px;
    padding: 0px 8px;
    font-weight: 600;
}
QHeaderView::section:hover {
    background-color: #e2e8f0;
    color: #0f172a;
}
QHeaderView::up-arrow {
    image: url(:/icons/ui/chevron_up_light.svg);
    width: 10px;
    height: 10px;
    subcontrol-origin: padding;
    subcontrol-position: center right;
    right: 6px;
}
QHeaderView::down-arrow {
    image: url(:/icons/ui/chevron_down_light.svg);
    width: 10px;
    height: 10px;
    subcontrol-origin: padding;
    subcontrol-position: center right;
    right: 6px;
}

/* ---- Activity Log ---- */
QPlainTextEdit {
    background-color: #f8fafc;
    color: #1e293b;
    border: 1px solid #cbd5e1;
    font-family: "Cascadia Code", "Consolas", "JetBrains Mono", monospace;
    font-size: 8.8pt;
}

/* ---- Splitters, ToolTips & Status Bar ---- */
QSplitter::handle {
    background-color: #e2e8f0;
}
QSplitter::handle:hover {
    background-color: #2563eb;
}
QToolTip {
    background-color: #ffffff;
    color: #0f172a;
    border: 1px solid #cbd5e1;
    border-radius: 4px;
    padding: 4px 8px;
}
QStatusBar {
    background-color: #ffffff;
    border-top: 1px solid #e2e8f0;
    color: #475569;
}
QStatusBar::item {
    border: none;
}
QStatusBar QLabel {
    color: #475569;
    padding: 0px 4px;
}

/* ---- Pane Chrome, Badges & Semantic Status Labels ---- */
QFrame#paneHeader {
    background-color: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
}
QLabel#paneFooter {
    background-color: #f8fafc;
    border-top: 1px solid #e2e8f0;
    color: #475569;
    padding: 0px 8px;
    font-size: 8.5pt;
}
QLabel#capBadge {
    background-color: #e0f2fe;
    border: 1px solid #bae6fd;
    border-radius: 4px;
    padding: 2px 8px;
    color: #0369a1;
    font-weight: 600;
    font-size: 8.5pt;
}
QLabel#ramBadge {
    background-color: #dbeafe;
    border: 1px solid #93c5fd;
    border-radius: 4px;
    padding: 2px 8px;
    color: #1d4ed8;
    font-weight: 600;
    font-size: 8.5pt;
}
QLabel[status="muted"] {
    color: #475569;
    font-size: 8.5pt;
}
QLabel[status="ok"] {
    color: #15803d;
    font-size: 8.5pt;
}
QLabel[status="warn"] {
    color: #b45309;
    font-size: 8.5pt;
}
QLabel[status="error"] {
    color: #b91c1c;
    font-size: 8.5pt;
    font-weight: 600;
}

/* ---- ScrollBars & Corner ---- */
QAbstractScrollArea::corner {
    background-color: #f8fafc;
    border: none;
}
QScrollBar:vertical {
    background: #f1f5f9;
    width: 10px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background: #cbd5e1;
    min-height: 24px;
    border-radius: 3px;
    margin: 2px;
}
QScrollBar::handle:vertical:hover {
    background: #94a3b8;
}
QScrollBar::handle:vertical:pressed {
    background: #64748b;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
    height: 0px;
}
QScrollBar:horizontal {
    background: #f1f5f9;
    height: 10px;
    margin: 0px;
}
QScrollBar::handle:horizontal {
    background: #cbd5e1;
    min-width: 24px;
    border-radius: 3px;
    margin: 2px;
}
QScrollBar::handle:horizontal:hover {
    background: #94a3b8;
}
QScrollBar::handle:horizontal:pressed {
    background: #64748b;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
    width: 0px;
}
