/* xsync Light Theme - Crisp modern Windows desktop look */
QMainWindow, QDialog {
    background-color: #f4f6fa;
    color: #0f172a;
}
QWidget {
    color: #0f172a;
    font-family: "Segoe UI", "Microsoft YaHei UI", "Inter", "Noto Sans CJK SC", sans-serif;
    font-size: 9.5pt;
}
QMenuBar {
    background-color: #ffffff;
    border-bottom: 1px solid #e2e8f0;
    padding: 2px 4px;
}
QMenu {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    padding: 4px;
}
QMenu::item {
    padding: 5px 22px 5px 12px;
    border-radius: 4px;
}
QMenu::item:selected {
    background-color: #2563eb;
    color: #ffffff;
}
QToolBar {
    background-color: #ffffff;
    border-bottom: 1px solid #e2e8f0;
    spacing: 6px;
    padding: 4px 8px;
}
QPushButton, QToolButton {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 5px;
    padding: 4px 10px;
    color: #1e293b;
}
QPushButton:hover, QToolButton:hover {
    background-color: #f1f5f9;
    border-color: #94a3b8;
}
QPushButton:disabled, QToolButton:disabled {
    background-color: #f1f5f9;
    border-color: #e2e8f0;
    color: #94a3b8;
}
QToolButton#starBtnActive {
    color: #d97706;
    border-color: #f59e0b;
    background-color: #fef3c7;
}
QPushButton#primaryBtn {
    background-color: #2563eb;
    border-color: #1d4ed8;
    color: #ffffff;
    font-weight: 600;
}
QPushButton#primaryBtn:hover {
    background-color: #1d4ed8;
}
QLineEdit, QComboBox, QSpinBox {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 5px;
    padding: 4px 8px;
    color: #0f172a;
    selection-background-color: #2563eb;
}
QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled {
    background-color: #f1f5f9;
    border-color: #e2e8f0;
    color: #94a3b8;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus {
    border-color: #2563eb;
}
QTabWidget::pane {
    border: 1px solid #cbd5e1;
    background-color: #ffffff;
    border-radius: 4px;
}
QTabBar::tab {
    background-color: #e2e8f0;
    border: 1px solid #cbd5e1;
    border-bottom: none;
    padding: 5px 12px;
    margin-right: 2px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    color: #475569;
}
QTabBar::tab:selected {
    background-color: #ffffff;
    color: #0f172a;
    font-weight: 600;
    border-top: 2px solid #2563eb;
}
QTableView, QTreeView, QTreeWidget {
    background-color: #ffffff;
    alternate-background-color: #f8fafc;
    border: 1px solid #dbe2ea;
    gridline-color: #eef2f6;
    selection-background-color: #2563eb;
    selection-color: #ffffff;
    outline: 0;
}
QHeaderView::section {
    background-color: #f1f5f9;
    color: #475569;
    border: none;
    border-right: 1px solid #e2e8f0;
    border-bottom: 1px solid #cbd5e1;
    padding: 5px 8px;
    font-weight: 600;
}
QPlainTextEdit {
    background-color: #f8fafc;
    color: #1e293b;
    border: 1px solid #cbd5e1;
    font-family: "Cascadia Code", "Consolas", monospace;
    font-size: 8.8pt;
}
QSplitter::handle {
    background-color: #e2e8f0;
}
QSplitter::handle:hover {
    background-color: #2563eb;
}
QStatusBar {
    background-color: #ffffff;
    border-top: 1px solid #e2e8f0;
    color: #475569;
}
QLabel#capBadge {
    background-color: #e0f2fe;
    border: 1px solid #bae6fd;
    border-radius: 4px;
    padding: 2px 7px;
    color: #0369a1;
    font-weight: 600;
    font-size: 8.5pt;
}
QLabel#ramBadge {
    background-color: #dbeafe;
    border: 1px solid #93c5fd;
    border-radius: 4px;
    padding: 1px 7px;
    color: #1d4ed8;
    font-weight: 600;
    font-size: 8.5pt;
}
QFrame#paneHeader {
    background-color: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
}
