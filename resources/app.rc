        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "xsync"
            VALUE "FileDescription", "xsync - Lightweight Qt6 rsync/SFTP/SCP File Transfer Client"
            VALUE "FileVersion", "1.0.1.0"
            VALUE "InternalName", "xsync"
            VALUE "OriginalFilename", "xsync.exe"
            VALUE "ProductName", "xsync"
            VALUE "ProductVersion", "1.0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
